{
  "family": "portfolio-chatbot",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "__TASK_EXECUTION_ROLE_ARN__",
  "taskRoleArn": "__TASK_ROLE_ARN__",
  "containerDefinitions": [
    {
      "name": "portfolio-chatbot",
      "image": "PLACEHOLDER_IMAGE",
      "essential": true,
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "DB_URL",
          "value": "__DB_URL__"
        },
        {
          "name": "CORS_ALLOWED_ORIGINS",
          "value": "__CORS_ALLOWED_ORIGINS__"
        },
        {
          "name": "SHOW_SQL",
          "value": "false"
        }
      ],
      "secrets": [
        {
          "name": "DB_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:__AWS_REGION__:__AWS_ACCOUNT_ID__:secret:portfolio-chatbot-db-credentials:SecretString:username::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:__AWS_REGION__:__AWS_ACCOUNT_ID__:secret:portfolio-chatbot-db-credentials:SecretString:password::"
        },
        {
          "name": "MISTRAL_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:__AWS_REGION__:__AWS_ACCOUNT_ID__:secret:portfolio-chatbot-mistral-api-key:SecretString:MISTRAL_API_KEY::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "__LOG_GROUP__",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "chatbot"
        }
      }
    }
  ]
}